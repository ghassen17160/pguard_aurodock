<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pguard_navigation</name>
  <version>0.1.0</version>
  <description>PRM (OMPL) global planner + DWA local planner for the pguard robot</description>
  <maintainer email="you@example.com">votre_nom</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>ompl</depend>
  <!-- OMPL n'a généralement pas de clé rosdep propre selon la distro ;
       si `rosdep install` échoue dessus, installez-le manuellement :
       sudo apt install libompl-dev -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
