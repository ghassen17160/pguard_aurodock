<?xml version="1.0"?>
<model>
  <name>pguard_charging_station</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>PearlGuard</name>
  </author>

  <description>
    Station de recharge statique pour le robot PearlGuard, avec un panneau
    AprilTag (famille tag36h11, id=0) mure vers +X, utilise par le package
    pguard_autodock pour l'approche et l'alignement automatique du robot.
  </description>
</model>
