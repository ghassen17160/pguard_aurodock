<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pguard_autodock</name>
  <version>1.0.0</version>
  <description>
    Autodocking par AprilTag pour PearlGuard : detection (apriltag_ros) et
    controleur d'approche/alignement (autodock_node) pour arrimer le robot
    a sa station de recharge.
  </description>
  <maintainer email="ghassen@example.com">ghassen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>